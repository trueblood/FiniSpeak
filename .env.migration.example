# Install requirements-migration.txt only in an offline/admin migration venv.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_CREDENTIALS=/secure/path/firebase-service-account.json

# Target must be explicitly checked before any --apply command.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=finispeak
MYSQL_USER=finispeak_migrator
MYSQL_PASSWORD=
FINISPEAK_STORAGE_ROOT=/var/lib/finispeak/private-files
