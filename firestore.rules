rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isActive() {
      let accountPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn() && (isAdmin()
        || !exists(accountPath)
        || !('status' in get(accountPath).data)
        || get(accountPath).data.status != 'suspended');
    }
    function userRole() { return isActive() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null; }
    function isTranslator() { return userRole() == 'translator'; }
    function callData(callId) { return get(/databases/$(database)/documents/calls/$(callId)).data; }
    function isCallParticipant(callId) {
      let c = callData(callId);
      return isActive() && (request.auth.uid == c.callerId || request.auth.uid == c.receiverId || request.auth.uid == c.translatorId);
    }
    function validReferenceItem() {
      return isActive()
        && request.resource.data.keys().hasAll(['name', 'nameLower', 'active', 'seeded', 'createdBy', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'nameLower', 'active', 'seeded', 'createdBy', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.nameLower is string && request.resource.data.nameLower.size() > 0 && request.resource.data.nameLower.size() <= 100
        && request.resource.data.active == true && request.resource.data.seeded == false
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
    }
    function validInterpreterSubmission() {
      let profile = request.resource.data;
      return profile.displayName is string && profile.displayName.size() > 0
        && profile.bio is string && profile.bio.size() > 0
        && profile.languages is list && profile.languages.size() > 0
        && profile.specialties is list && profile.specialties.size() > 0
        && profile.yearsExperience is number && profile.yearsExperience >= 0 && profile.yearsExperience <= 80
        && profile.credentials is list && profile.credentials.size() > 0
        && profile.credentialDocuments is list && profile.credentialDocuments.size() > 0
        && profile.availability is map
        && profile.availability.days is list && profile.availability.days.size() > 0
        && profile.availability.start is string && profile.availability.start.size() > 0
        && profile.availability.end is string && profile.availability.end.size() > 0
        && profile.onboardingStatus == 'submitted';
    }
    function validInterpreterOwnerUpdate() {
      let credentialStatus = request.resource.data.credentialStatus;
      let onboardingStatus = request.resource.data.onboardingStatus;
      return credentialStatus in ['unsubmitted', 'submitted', 'needs_changes', 'approved', 'rejected']
        && (credentialStatus == 'submitted'
          || (credentialStatus == 'unsubmitted' && !('credentialStatus' in resource.data))
          || ('credentialStatus' in resource.data && credentialStatus == resource.data.credentialStatus))
        && (onboardingStatus == resource.data.onboardingStatus || onboardingStatus in ['draft', 'complete', 'submitted'])
        && (credentialStatus != 'submitted' || validInterpreterSubmission());
    }
    function hasNoPrivateInterpreterFields() {
      return !request.resource.data.keys().hasAny([
        'email', 'phone', 'credentialDocuments', 'verificationNotes', 'serviceArea', 'address'
      ]);
    }
    function validServiceSettings() {
      let profile = request.resource.data;
      return !('serviceOptions' in profile) || (
        profile.serviceOptions is map
        && profile.serviceOptions.inPerson is bool
        && profile.serviceOptions.remote is bool
        && profile.serviceOptions.radiusMiles in [5, 10, 25, 50, 100]
        && (!('serviceLocation' in profile) || profile.serviceLocation == null || (
          profile.serviceLocation is map
          && (!('showOnMap' in profile.serviceLocation) || (
            profile.serviceLocation.showOnMap is bool
            && (!profile.serviceLocation.showOnMap || (
            profile.serviceOptions.inPerson == true
            && profile.serviceLocation.latitude is number
            && profile.serviceLocation.latitude >= -90 && profile.serviceLocation.latitude <= 90
            && profile.serviceLocation.longitude is number
            && profile.serviceLocation.longitude >= -180 && profile.serviceLocation.longitude <= 180
            && profile.serviceLocation.geohash is string
            ))
          ))
        ))
      );
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.role in ['customer', 'translator'];
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'phone', 'phoneNormalized', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /emailDirectory/{email} {
      // Exact lookup is required for customer-to-customer calling. Collection
      // listing would expose the entire account directory.
      allow get: if isActive();
      allow list: if false;
      allow create, update: if isActive() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (isActive() && resource.data.uid == request.auth.uid);
    }

    match /translators/{translatorId} {
      allow read: if isAdmin()
        || (isActive() && request.auth.uid == translatorId)
        || (isActive() && resource.data.verificationStatus == 'verified');
      allow create: if isActive() && request.auth.uid == translatorId
        && request.resource.data.verificationStatus == 'unverified'
        && hasNoPrivateInterpreterFields() && validServiceSettings();
      allow update: if isAdmin() || (isActive() && request.auth.uid == translatorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'email', 'phone', 'bio', 'languages', 'dialects', 'specialties',
          'yearsExperience', 'credentials', 'credentialDocuments', 'credentialStatus', 'availability',
          'photoUrl', 'onboardingStatus', 'updatedAt', 'verificationNotes',
          'serviceArea', 'serviceLocation', 'serviceOptions'
        ]) && validInterpreterOwnerUpdate() && hasNoPrivateInterpreterFields() && validServiceSettings());
      allow delete: if isAdmin() || (isActive() && request.auth.uid == translatorId);

      match /reviews/{reviewId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    match /interpreterPrivate/{translatorId} {
      allow read: if isAdmin() || (isActive() && request.auth.uid == translatorId);
      allow create: if isAdmin() || (isActive() && request.auth.uid == translatorId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'phone', 'credentialDocuments', 'createdAt', 'updatedAt'
        ]));
      allow update: if isAdmin() || (isActive() && request.auth.uid == translatorId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'email', 'phone', 'credentialDocuments', 'createdAt', 'updatedAt'
        ]));
      allow delete: if isAdmin() || (isActive() && request.auth.uid == translatorId);
    }

    match /reference_languages/{itemId} { allow read: if true; allow create: if validReferenceItem(); allow update, delete: if isAdmin(); }
    match /reference_dialects/{itemId} { allow read: if true; allow create: if validReferenceItem(); allow update, delete: if isAdmin(); }
    match /reference_specialties/{itemId} { allow read: if true; allow create: if validReferenceItem(); allow update, delete: if isAdmin(); }

    match /calls/{callId} {
      // Call documents are created and transitioned by the authenticated API.
      // Clients retain real-time reads and write only scoped signaling data.
      allow create: if isAdmin();
      allow read: if isAdmin() || isCallParticipant(callId) || (isTranslator() && resource.data.translationStatus == 'requested');
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /participants/{participantId} {
        allow read: if isAdmin() || isCallParticipant(callId);
        allow create, update, delete: if isAdmin() || (isCallParticipant(callId) && request.auth.uid == participantId);
      }
      match /connections/{connectionId}/{document=**} { allow read, write: if isAdmin() || isCallParticipant(callId); }
      match /transcripts/{transcriptId} {
        allow read: if isAdmin() || isCallParticipant(callId);
        allow create: if isCallParticipant(callId) && request.resource.data.speakerId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    match /organizations/{organizationId} { allow read, write: if isAdmin(); }
  }
}
