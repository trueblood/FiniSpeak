# MySQL 8 is the only application repository backend.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=finispeak
MYSQL_USER=finispeak_app
MYSQL_PASSWORD=
FINISPEAK_REPOSITORY_BACKEND=mysql
FINISPEAK_MYSQL_PRIMARY_ENABLED=true
FINISPEAK_MYSQL_EXPECTED_REVISION=20261014_0003
FINISPEAK_MYSQL_RECONCILED_AT=
FINISPEAK_MYSQL_RECONCILIATION_DIGEST=
FINISPEAK_MYSQL_RECONCILIATION_MAX_AGE_SECONDS=1800
FINISPEAK_TEST_DEPLOYMENT=false

# First-party authentication. Generate at least 32 random bytes.
FINISPEAK_ENV=production
FINISPEAK_JWT_SECRET=
FINISPEAK_COOKIE_SECURE=true
FINISPEAK_SESSION_HOURS=12
FINISPEAK_PUBLIC_URL=https://example.com

# Verification and password-recovery email.
FINISPEAK_SMTP_HOST=
FINISPEAK_SMTP_PORT=465
FINISPEAK_SMTP_SECURITY=ssl
FINISPEAK_SMTP_USERNAME=
FINISPEAK_SMTP_PASSWORD=
FINISPEAK_EMAIL_FROM=

# Private files must be outside /var/www/finispeak and backed up separately.
FINISPEAK_STORAGE_ROOT=/var/lib/finispeak/private-files
FINISPEAK_UPLOAD_MAX_BYTES=10485760

# Self-hosted or selected STUN/TURN service. TURN is required for readiness.
FINISPEAK_STUN_URLS=stun:turn.example.com:3478
FINISPEAK_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# At least 32 random bytes; configure coturn use-auth-secret/static-auth-secret.
FINISPEAK_TURN_SECRET=

OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
TRANSCRIPTION_CHUNK_SECONDS=5.0
CONCURRENT_TRANSCRIPTION_WORKERS=2
STREAMING_TRANSCRIPTION_CHUNK_SECONDS=1.5
# Set this to the selected provider's estimated transcription price per audio minute.
TRANSCRIPTION_ESTIMATED_USD_PER_MINUTE=0
FINISPEAK_API_KEY_PEPPER=
LANGUAGE_EVIDENCE_WINDOW=6
LANGUAGE_MINIMUM_SAMPLES=2
LANGUAGE_CONFIRMATION_THRESHOLD=0.78
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=FiniSpeak/1.0 (support@example.com)
