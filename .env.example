FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=finispeak
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
# Optional local service-account path. Cloud Run should use its attached identity.
FIREBASE_CREDENTIALS=
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
TRANSCRIPTION_CHUNK_SECONDS=5.0
# Required before issuing commercial API keys. Use at least 32 random bytes.
FINISPEAK_API_KEY_PEPPER=
LANGUAGE_EVIDENCE_WINDOW=6
LANGUAGE_MINIMUM_SAMPLES=2
LANGUAGE_CONFIRMATION_THRESHOLD=0.78
# Configurable production map provider. Keep attribution required by the provider.
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=FiniSpeak/1.0 (support@finispeak.com)
# Repository cutover defaults. Keep both activation flags false until a fresh
# production reconciliation has passed; never put passwords or digests here.
FINISPEAK_REPOSITORY_BACKEND=firestore
FINISPEAK_SHADOW_COMPARISON_ENABLED=false
FINISPEAK_SHADOW_WRITES_ENABLED=false
FINISPEAK_MYSQL_PRIMARY_ENABLED=false
FINISPEAK_MYSQL_EXPECTED_REVISION=
FINISPEAK_MYSQL_RECONCILED_AT=
FINISPEAK_MYSQL_RECONCILIATION_DIGEST=
FINISPEAK_MYSQL_RECONCILIATION_MAX_AGE_SECONDS=1800
